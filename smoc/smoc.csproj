<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>

    <Version>0.2.0</Version>
    <Authors>Matt Razza</Authors>
    <Product>SMoC</Product>
    <AssemblyVersion>0.2.0</AssemblyVersion>
    <FileVersion>0.2.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <Description>Streaming Music on Console</Description>
  </PropertyGroup>

  <ItemGroup>
      <EmbeddedResource Include="Resources\config.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="smoc.tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SoundFlow" Version="1.4.0" />
    <PackageReference Include="SoundFlow.Codecs.FFMpeg" Version="1.4.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.1" />
    <PackageReference Include="YouTubeMusicAPI" Version="3.0.6" />
    <PackageReference Include="YouTubeSessionGenerator" Version="1.0.3" />
    <ProjectReference Include="..\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj" />
  </ItemGroup>

</Project>
